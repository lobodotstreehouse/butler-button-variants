# Veltm Supabase project — Butler Button booking API
#
# Both values are SAFE TO COMMIT (already public on veltmtours.com,
# protected server-side via CORS allow-list + RLS), but env-var
# hygiene is still preferred.
#
# Currently the modal snippet inlines these constants directly in
# zoho-inject/*v3*.js and zoho-inject/_modal-snippet.js (search for
# `API_CFG`). When/if a build step is added, source from these env
# vars and substitute at build time.
#
# DO NOT add the service-role key or BUTLER_BOOKING_API_KEY here.
# Those are server-only secrets and must never appear in this repo.

VELTM_SUPABASE_URL=https://glhbwpfkykycexyygwjj.supabase.co
VELTM_SUPABASE_ANON_KEY=


# ─────────────────────────────────────────────────────────────────────
# Demo / 15-minute-meeting request forms  (tools/request_forms.py)
#
# Powers POST /forms/request, used by the "Request a demo" and
# "Request a 15-minute meeting" buttons on
# proposed/hotel-concierge-program.html. Each submission gets a unique
# request ID that goes into BOTH the mail to the team and the
# acknowledgement to the requester.
#
# SMTP_PASSWORD is a real secret: set it with `heroku config:set`, and
# never commit the filled-in value. With SMTP_HOST unset the endpoint
# returns 503 and logs the full submission to stderr, and the page
# falls back to a pre-filled mailto — nothing is silently dropped.
# ─────────────────────────────────────────────────────────────────────

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# starttls (default, port 587) | ssl (port 465) | none (local testing)
SMTP_SECURITY=starttls
# Envelope sender. Must be an address the SMTP account is allowed to send as.
SMTP_FROM=partners@butlerbutton.co
SMTP_FROM_NAME=Butler Button

# Where submissions land. Requester goes on Reply-To.
BB_TEAM_EMAIL=partners@butlerbutton.co
BB_SITE_URL=https://butlerbutton.co

# Optional: per-IP throttle, and extra browser origins allowed to post
# (same-origin posts need no entry here).
# BB_FORMS_RATE_MAX=5
# BB_FORMS_RATE_WINDOW=600
# BB_FORMS_ALLOWED_ORIGINS=https://butlerbutton.co,https://www.butlerbutton.co
